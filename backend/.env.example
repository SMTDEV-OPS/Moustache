GMAIL_PUBSUB_TOPIC=projects/YOUR_PROJECT_ID/topics/gmail-inbox-changes
GMAIL_WEBHOOK_SECRET=your_random_secret_string

# Gmail OAuth (per-user fallback for non-Workspace addresses)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/email/accounts/connect/gmail/callback

# Google Workspace domain-wide delegation (admin configures in Integration Hub)
# When configured via Integration Hub, GOOGLE_CLIENT_ID/SECRET are not required for Workspace users.
# Service account + domain are stored encrypted in the database (EMAIL_ENCRYPTION_KEY).

# Microsoft OAuth (Outlook)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# Required for encrypting SMTP/IMAP passwords and Workspace service account keys
EMAIL_ENCRYPTION_KEY=change-me-in-production

# Optional: base URL for quotation email webfonts (woff2 files). See backend/src/constants/quotationVisualBranding.ts (FONT_WOFF2_FILES).
# Example: https://your-cdn.s3.amazonaws.com/quotation-fonts
QUOTATION_FONT_CDN_BASE=
